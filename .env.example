# Copie para .env e preencha. NUNCA comite o .env (já está no .gitignore).
# No easypanel, estes vão em Settings → Environment.

# ===== Sistema alvo =====
RECEITANET_USER=
RECEITANET_PASS=

# ===== n8n =====
# Base da public API, terminando em /api/v1
N8N_API_URL=
# n8n → Settings → API → Show key
N8N_API_KEY=
# Id da credential httpHeaderAuth que guarda o cookie
N8N_CREDENTIAL_ID=

# ===== Auth do endpoint /renew =====
# Gere com: openssl rand -hex 32
RENEW_AUTH_TOKEN=

# ===== Alertas de WhatsApp (opcional; sem os 3, o alerta é só logado) =====
# Endpoint de envio do gateway
WEBHOOK_ALERTA_URL=
# Token do gateway — trate como segredo, rotacione se vazar
UAZAPI_TOKEN_ALERTA=
# Número que recebe os alertas: só dígitos, com DDI. Ex: 55DDNNNNNNNNN
ALERTA_WHATSAPP_DESTINO=

# ===== Tuning =====
HEADLESS=true
PORT=8080
